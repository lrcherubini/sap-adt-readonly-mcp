{
  "name": "sap-adt-readonly-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Read-only MCP server over the SAP ADT REST API (S/4HANA / ABAP Platform)",
  "license": "MIT",
  "author": "Leandro R Cherubini",
  "repository": {
    "type": "git",
    "url": "<public repository URL>"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "adt": "node server.mjs",
    "probe": "node scripts/probe.mjs",
    "config": "node scripts/config.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:guard": "node --test tests/guard.test.mjs tests/adt-get.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-lines=97 --test-coverage-branches=83 --test-coverage-functions=94 tests/*.test.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "measure:ddla": "node scripts/measure-annotation-defs.mjs",
    "report": "node scripts/report.mjs",
    "logs:prune": "node scripts/prune-logs.mjs",
    "propose:table": "node scripts/propose-customizing-table.mjs",
    "lint:commit": "node scripts/lint-commit.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "overrides": {
    "qs": ">=6.16.0"
  }
}
